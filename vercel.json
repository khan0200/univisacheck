{
  "rewrites": [
    {
      "source": "/api/check-status",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/check-status/:path*",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/students",
      "destination": "/api/students.js"
    },
    {
      "source": "/api/download-visa-pdf",
      "destination": "/api/download-visa-pdf.js"
    },
    {
      "source": "/api/ai-assistant",
      "destination": "/api/ai-assistant.js"
    },
    {
      "source": "/api/visa-calc-leads",
      "destination": "/api/visa-calc-leads.js"
    },
    {
      "source": "/api/qabul-dates",
      "destination": "/api/qabul-dates.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
